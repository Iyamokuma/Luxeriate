{
  "name": "luxuriate-foodstuff",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:db": "tsx scripts/test-db.ts",
    "create-owner": "tsx --env-file=.env.local scripts/create-owner.ts",
    "demo:seed": "tsx --env-file=.env.local scripts/demo-data.ts seed",
    "demo:password": "tsx --env-file=.env.local scripts/demo-data.ts password",
    "demo:clear": "tsx --env-file=.env.local scripts/demo-data.ts clear",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked > src/types/supabase.ts"
  },
  "dependencies": {
    "@paystack/inline-js": "^2.28.2",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "nodemailer": "^10.6.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "0.181.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.181.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.17.0"
}
