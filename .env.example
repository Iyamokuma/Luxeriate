# ─── Site ────────────────────────────────────────────────────────────────
# Public URL of the website (used in emails, Paystack callbacks and receipts)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase ────────────────────────────────────────────────────────────
# Project Settings → API. Either the new publishable/secret keys or the
# legacy anon/service_role keys work.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only. Never expose this key in the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# ─── Paystack ────────────────────────────────────────────────────────────
# Dashboard → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_test_xxx
# Webhook URL to paste into Paystack: https://YOUR-DOMAIN/api/paystack/webhook

# Simulated checkout for local development when you have no Paystack keys yet.
# Ignored in production builds.
PAYSTACK_TEST_MODE=false

# Optional personal account numbers (Dedicated Virtual Accounts). Requires a
# CAC-registered Paystack business with the feature enabled.
PAYSTACK_DVA_ENABLED=false
PAYSTACK_DVA_PREFERRED_BANK=wema-bank

# ─── Email ───────────────────────────────────────────────────────────────
# resend | smtp | console  (console prints emails to the server log)
EMAIL_PROVIDER=console
EMAIL_FROM="Luxuriate Foodstuff <hello@your-domain.com>"
EMAIL_REPLY_TO=hello@your-domain.com
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Scheduled jobs ──────────────────────────────────────────────────────
# Shared secret for /api/cron/reminders (Vercel Cron sends it automatically)
CRON_SECRET=change-me-to-a-long-random-string
